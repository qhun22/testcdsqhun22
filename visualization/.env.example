# Cloudflare R2 — Data Lake (NDJSON / Iceberg)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=cho-nha-data-lake
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Cloudflare Basin Catalog — Iceberg REST (để trống nếu chưa có quyền)
CF_CATALOG_TOKEN=
CF_CATALOG_ACCOUNT_ID=your_cloudflare_account_id
CF_CATALOG_BUCKET=cho-nha-data-lake

# Worker API (fallback khi R2 không truy cập được trực tiếp)
WORKER_URL=https://your-worker.workers.dev
WORKER_ADMIN_TOKEN=your_admin_token
