{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testcdsqhun22",
  "account_id": "c0569221e44f432f6669b8df70446872",
  "main": "apps/api/src/index.js",
  "compatibility_date": "2026-09-28",
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": "./apps/storefront",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/index.html", "/dashboard", "/dashboard/"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "VIETQR_BANK_ID": "970415",
    "VIETQR_ACCOUNT_NUMBER": "0975150984",
    "VIETQR_ACCOUNT_NAME": "TRUONG QUANG HUY",
    "TELEGRAM_ADMIN_CHAT_ID": "5032505212"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cho-nha-db",
      "database_id": "14fdc297-226d-44ea-a353-5370979bffd9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "cho-nha-data-lake"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cho_nha_events"
    }
  ]
}