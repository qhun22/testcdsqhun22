{
  "name": "cho-nha-commerce",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "db:local": "wrangler d1 migrations apply cho-nha-db --local",
    "db:remote": "wrangler d1 migrations apply cho-nha-db --remote",
    "deploy": "wrangler deploy",
    "test": "node --test tests/telegram-payment.test.js tests/analytics.test.js",
    "telegram:poll": "node scripts/poll-telegram.js",
    "telegram:set-webhook": "node scripts/setup-telegram-webhook.js set",
    "telegram:delete-webhook": "node scripts/setup-telegram-webhook.js delete",
    "telegram:webhook-info": "node scripts/setup-telegram-webhook.js info"
  },
  "devDependencies": {
    "docx": "^9.8.0",
    "wrangler": "^4.20.0"
  }
}
